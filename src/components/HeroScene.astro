---
import Mascot from './Mascot.astro';
---
<div class="hero-art" aria-hidden="true">
  <span class="sun-disk"></span>
  <svg class="hero-cloud cloud-one" viewBox="0 0 220 80"><path d="M35 63C9 63 8 37 31 33C33 5 71 1 86 23C98-1 141 6 150 33C178 14 214 37 203 59C198 70 36 71 35 63Z" fill="#fff9ed"/></svg>
  <svg class="hero-cloud cloud-two" viewBox="0 0 220 80"><path d="M35 63C9 63 8 37 31 33C33 5 71 1 86 23C98-1 141 6 150 33C178 14 214 37 203 59C198 70 36 71 35 63Z" fill="#fff9ed"/></svg>
  <svg class="hero-cloud cloud-three" viewBox="0 0 220 80"><path d="M35 63C9 63 8 37 31 33C33 5 71 1 86 23C98-1 141 6 150 33C178 14 214 37 203 59C198 70 36 71 35 63Z" fill="#fff9ed"/></svg>
  <svg class="small-parasol parasol-one" viewBox="0 0 128 110"><path d="M7 48C20 7 91-2 122 48C99 39 87 42 68 56C48 42 31 41 7 48Z" fill="#E86455" stroke="#623D3A" stroke-width="4"/><path d="M68 56L67 20" stroke="#623D3A" stroke-width="3"/><path d="M68 55L70 103" stroke="#623D3A" stroke-width="4" stroke-linecap="round"/></svg>
  <svg class="small-parasol parasol-two" viewBox="0 0 128 110"><path d="M7 48C20 7 91-2 122 48C99 39 87 42 68 56C48 42 31 41 7 48Z" fill="#D78B5E" stroke="#623D3A" stroke-width="4"/><path d="M68 56L67 20" stroke="#623D3A" stroke-width="3"/><path d="M68 55L70 103" stroke="#623D3A" stroke-width="4" stroke-linecap="round"/></svg>
  <div class="hill hill-back"></div><div class="hill hill-mid"></div><div class="hill hill-front"></div>
  <span class="hero-sparkle sparkle-one">✳</span><span class="hero-sparkle sparkle-two">✧</span>
  <Mascot class="hero-mascot"/>
  <div class="hero-art-caption">IMAGINATION<br/>STARTS HERE ✳</div>
</div>
