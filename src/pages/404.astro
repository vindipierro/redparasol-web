---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found"
  description="This world couldn't be found. Find your way back to Red Parasol or explore another adventure."
  noindex
>
  <section class="not-found">
    <div class="not-found-content container">
      <div class="not-found-copy">
        <p class="eyebrow not-found-eyebrow"><span class="eyebrow-star" aria-hidden="true"></span> 404 / WORLD NOT FOUND</p>
        <h1>You've wandered<br/><em>off the map.</em></h1>
        <p class="not-found-description">This page doesn't seem to exist in our world. But there are plenty of other places to explore.</p>
        <div class="not-found-actions">
          <a class="button button-dark" href="/">Back to home <span class="outbound-arrow" aria-hidden="true"></span></a>
          <a class="not-found-explore" href="/games/">Explore our games <span class="outbound-arrow" aria-hidden="true"></span></a>
        </div>
        <p class="not-found-signoff"><span aria-hidden="true"></span> EVERY DETOUR IS ANOTHER ADVENTURE.</p>
      </div>

      <div class="not-found-scene" aria-hidden="true">
        <div class="not-found-sun"></div>
        <span class="not-found-code">404</span>
        <svg class="not-found-cloud not-found-cloud-one" viewBox="0 0 220 80"><path d="M35 63C9 63 8 37 31 33C33 5 71 1 86 23C98-1 141 6 150 33C178 14 214 37 203 59C198 70 36 71 35 63Z" fill="#fff9ed"/></svg>
        <svg class="not-found-cloud not-found-cloud-two" viewBox="0 0 220 80"><path d="M35 63C9 63 8 37 31 33C33 5 71 1 86 23C98-1 141 6 150 33C178 14 214 37 203 59C198 70 36 71 35 63Z" fill="#fff9ed"/></svg>
        <span class="not-found-spark not-found-spark-one"></span>
        <span class="not-found-spark not-found-spark-two"></span>
        <div class="not-found-hill not-found-hill-back"></div>
        <div class="not-found-hill not-found-hill-front"></div>
        <img class="not-found-mascot" src="/images/brand/mascot-full.webp" alt="" width="768" height="768" decoding="async"/>
        <span class="not-found-scene-label">SOMEWHERE OUT THERE<br/>A NEW STORY AWAITS</span>
      </div>
    </div>
    <div class="not-found-bottom">
      <div class="container not-found-bottom-inner">
        <span>RED PARASOL / ENDLESS POSSIBILITIES</span>
        <span>WE BUILD WORLDS. YOU WRITE THE STORY.</span>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    background: var(--cream);
    overflow: hidden;
  }
  .not-found-content {
    min-height: min(750px, calc(100svh - 88px));
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    align-items: center;
    position: relative;
  }
  .not-found-copy {
    position: relative;
    z-index: 5;
    padding: 100px 0 115px;
  }
  .not-found-eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    color: #995c4e;
    margin-bottom: 30px;
  }
  .not-found h1 {
    font-size: clamp(52px, 5.5vw, 86px);
    line-height: 1.01;
    letter-spacing: -.065em;
    font-weight: 800;
  }
  .not-found h1 em { color: var(--coral-deep) }
  .not-found-description {
    max-width: 480px;
    margin-top: 25px;
    color: #58514e;
    font-size: 17px;
    line-height: 1.75;
  }
  .not-found-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 25px;
    margin-top: 35px;
  }
  .not-found-explore {
    display: inline-flex;
    gap: 11px;
    align-items: center;
    font-size: 14px;
    font-weight: 800;
    border-bottom: 1px solid var(--ink);
    padding: 9px 0 6px;
    transition: color .2s, gap .2s;
  }
  .not-found-explore:hover { color: var(--coral-deep); gap: 17px }
  .not-found-explore .outbound-arrow { width: 15px; height: 15px }
  .not-found-signoff {
    display: flex;
    align-items: center;
    gap: 11px;
    margin-top: 79px;
    color: #a1796e;
    font: 800 10px/1.5 "Outfit", sans-serif;
    letter-spacing: .15em;
  }
  .not-found-signoff span {
    background: var(--coral);
    width: 17px;
    height: 17px;
    flex: none;
    clip-path: var(--spark-shape);
  }
  .not-found-scene {
    height: 620px;
    align-self: end;
    position: relative;
    min-width: 0;
    pointer-events: none;
    isolation: isolate;
  }
  .not-found-sun {
    position: absolute;
    width: min(85%, 440px);
    aspect-ratio: 1;
    border-radius: 50%;
    top: 11%;
    right: 0;
    background: #f3d5b2;
    z-index: 0;
  }
  .not-found-code {
    position: absolute;
    z-index: 1;
    top: 11%;
    left: 48%;
    transform: translateX(-50%);
    color: #d57a69;
    font: 800 clamp(160px, 18.5vw, 260px)/1 "Outfit", sans-serif;
    letter-spacing: -.095em;
    white-space: nowrap;
  }
  .not-found-cloud {
    position: absolute;
    z-index: 2;
    width: 135px;
    opacity: .94;
    animation: not-found-drift 8s ease-in-out infinite alternate;
  }
  .not-found-cloud-one { top: 6%; right: -11%; }
  .not-found-cloud-two { top: 35%; left: -12%; width: 105px; animation-delay: -3s }
  .not-found-spark {
    position: absolute;
    z-index: 4;
    background: var(--coral);
    clip-path: var(--spark-shape);
  }
  .not-found-spark-one { width: 31px; height: 31px; right: 5%; top: 33% }
  .not-found-spark-two { width: 19px; height: 19px; left: 4%; top: 24%; background: #ca895c }
  .not-found-hill {
    position: absolute;
    width: 145%;
    height: 265px;
    border-radius: 50%;
    bottom: -151px;
    z-index: 2;
  }
  .not-found-hill-back {
    background: #b2c9ad;
    transform: rotate(-11deg);
    right: -60%;
    bottom: -85px;
  }
  .not-found-hill-front {
    background: #79b39b;
    transform: rotate(8deg);
    left: -30%;
    z-index: 3;
  }
  .not-found-mascot {
    position: absolute;
    z-index: 5;
    width: min(78%, 430px);
    object-fit: contain;
    right: 3%;
    bottom: 4px;
    filter: drop-shadow(10px 16px 0 rgba(71,40,42,.1));
    animation: not-found-bob 5s ease-in-out infinite;
  }
  .not-found-scene-label {
    position: absolute;
    z-index: 6;
    bottom: 38px;
    left: 1%;
    color: #426b5f;
    font: 800 10px/1.5 "Outfit", sans-serif;
    letter-spacing: .11em;
    transform: rotate(-7deg);
  }
  .not-found-bottom { background: var(--coral); border-top: 2px solid var(--ink) }
  .not-found-bottom-inner {
    min-height: 52px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    color: var(--ink);
    font: 800 11px/1.5 "Outfit", sans-serif;
    letter-spacing: .12em;
  }
  @keyframes not-found-bob {
    0%,100% { transform: translateY(0) }
    50% { transform: translateY(-10px) }
  }
  @keyframes not-found-drift {
    from { transform: translateX(-9px) }
    to { transform: translateX(9px) }
  }
  @media (max-width: 1100px) {
    .not-found h1 { font-size: clamp(47px, 5.8vw, 70px) }
    .not-found-scene { height: 550px }
    .not-found-signoff { margin-top: 62px }
  }
  @media (max-width: 800px) {
    .not-found-content { display: flex; flex-direction: column; min-height: 0; align-items: stretch }
    .not-found-copy { padding: 76px 0 20px }
    .not-found h1 { font-size: clamp(47px, 9vw, 70px) }
    .not-found-description { font-size: 16px }
    .not-found-scene { width: min(100%, 540px); height: 440px; margin: 0 auto; align-self: center }
    .not-found-code { font-size: clamp(155px, 32vw, 230px); top: 6% }
    .not-found-sun { top: 5%; right: 5%; width: 74% }
    .not-found-mascot { width: min(75%, 355px); right: 9% }
    .not-found-signoff { margin-top: 40px }
  }
  @media (max-width: 540px) {
    .not-found-copy { padding: 56px 0 0 }
    .not-found-eyebrow { font-size: 10px; margin-bottom: 22px; letter-spacing: .1em }
    .not-found h1 { font-size: clamp(40px, 10.5vw, 57px); letter-spacing: -.055em }
    .not-found-description { font-size: 15px; line-height: 1.65; margin-top: 20px }
    .not-found-actions { gap: 20px; margin-top: 27px }
    .not-found-actions .button { padding: 15px 20px; font-size: 13px }
    .not-found-explore { font-size: 13px }
    .not-found-signoff { margin-top: 35px; font-size: 9px; letter-spacing: .1em }
    .not-found-scene { height: 315px; margin-top: 25px }
    .not-found-code { font-size: clamp(143px, 35vw, 190px); top: 0 }
    .not-found-sun { width: 76%; top: 2% }
    .not-found-cloud-one { right: -2%; top: 1%; width: 100px }
    .not-found-cloud-two { left: -5%; width: 75px; top: 33% }
    .not-found-spark-one { width: 23px; height: 23px }
    .not-found-mascot { width: min(76%, 280px); right: 7%; bottom: -5px }
    .not-found-hill { height: 190px; bottom: -120px }
    .not-found-hill-back { bottom: -80px }
    .not-found-scene-label { font-size: 8px; bottom: 23px }
    .not-found-bottom-inner { min-height: 46px; font-size: 9px }
    .not-found-bottom-inner span:last-child { display: none }
  }
  @media (prefers-reduced-motion: reduce) {
    .not-found-mascot, .not-found-cloud { animation: none }
  }
</style>
