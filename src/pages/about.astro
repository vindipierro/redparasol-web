---
import BaseLayout from '../layouts/BaseLayout.astro';
import Mascot from '../components/Mascot.astro';
import { games } from '../data/games';
import { studio } from '../data/studio';
---
<BaseLayout title="About the Studio" description="Get to know Red Parasol, an independent Roblox game development studio creating roleplay worlds and simulations.">
  <section class="page-hero about-hero">
    <div class="container about-hero-grid">
      <div><p class="eyebrow">HELLO, WE'RE RED PARASOL ✳</p><h1>Made to play.<br/><em>Made your own.</em></h1><p>We're an independent Roblox game development studio creating places worth exploring, roles worth stepping into, and stories worth sharing.</p></div>
      <div class="about-mascot-wrap"><span class="about-ring" aria-hidden="true"></span><Mascot class="about-mascot"/></div>
    </div>
  </section>
  <section class="section section-dark about-content">
    <div class="container about-content-grid">
      <div><p class="eyebrow red-eyebrow">WHAT WE BELIEVE</p><h2>A world is only<br/><em>the beginning.</em></h2></div>
      <div><p>Founded in {studio.foundedYear}, Red Parasol builds roleplay and simulation experiences for players who want to do more than follow a predetermined path.</p><p>Whether you're exploring school life, serving in government, trading your way through a new world, or finding a place to belong, our games are built around what happens when players make a world their own.</p><a class="text-link" href="/games/">Explore our {games.length} active experiences <span aria-hidden="true">↗</span></a></div>
    </div>
  </section>
  <section class="section about-closer"><div class="container"><p class="eyebrow">OUR PROMISE</p><h2>We build worlds.<br/><em>You write the story.</em></h2></div></section>
</BaseLayout>
