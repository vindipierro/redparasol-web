---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { games, formatMilestone, formatPeakCCU, formatReleaseMonth, getGenreLabel, type Game } from '../../data/games';
import officialArtwork from '../../data/game-thumbnails.json';
export function getStaticPaths() {
  return games.map((game) => ({ params: { slug: game.slug }, props: { game } }));
}
interface Props { game: Game }
const { game } = Astro.props;
const visits = formatMilestone(game.lifetimeVisits);
const displayedPeak = formatPeakCCU(game.peakCCU, game.slug === 'seishun');
const release = formatReleaseMonth(game.releaseMonth, game.releaseYear);
const factCount = 1 + Number(Boolean(visits)) + Number(Boolean(displayedPeak)) + Number(Boolean(release));
const banner = game.banner ?? (officialArtwork as Record<string, string>)[game.slug];
const related = games.filter((item) => item.slug !== game.slug && (item.genre === game.genre || (item.tags ?? []).includes(game.genre))).slice(0, 3);
---
<BaseLayout title={game.title} description={game.description}>
  <section class="detail-top">
    <div class="container">
      <a href="/games/" class="back-link">← All games</a>
      <div class="detail-title-row">
        <div><p class="eyebrow">{getGenreLabel(game.genre)} / RED PARASOL</p><h1>{game.title}</h1><p class="detail-description">{game.description}</p></div>
        {game.robloxUrl ? <a class="button button-dark detail-cta" href={game.robloxUrl} target="_blank" rel="noopener noreferrer">Play on Roblox <span aria-hidden="true">↗</span></a> : <span class="button button-muted detail-cta" aria-label="Direct game link not yet verified">Play link pending</span>}
      </div>
    </div>
  </section>
  <section class:list={['detail-art-stage', 'theme-' + game.genre]}>
    <div class="container">
      {banner ? <img class="detail-banner" src={banner} alt={game.title + ' official artwork'}/> : <div class="detail-art-placeholder"><span class="detail-art-sun"></span><span class="detail-art-ring"></span><span class="detail-art-shape"></span><strong>{game.shortTitle ?? game.title}</strong><small>GAME ARTWORK / COMING SOON</small></div>}
    </div>
  </section>
  <section class="section section-dark detail-body">
    <div class="container">
      <p class="eyebrow red-eyebrow">THE EXPERIENCE</p>
      <div class="detail-facts" data-count={factCount} style={`--fact-count: ${factCount}`}>
        <div><span>Genre</span><strong>{getGenreLabel(game.genre)}</strong></div>
        {visits && <div><span>Lifetime visits</span><strong>{visits}</strong></div>}
        {displayedPeak && <div><span>Peak CCU</span><strong>{displayedPeak}</strong></div>}
        {release && <div><span>Release</span><strong>{release}</strong></div>}
      </div>
      {(game.peakCCU === null) && <p class="detail-data-note">Additional verified historical peak CCU details will appear here when available.</p>}
      {game.robloxUrl && <a class="button button-coral" href={game.robloxUrl} target="_blank" rel="noopener noreferrer">Open experience on Roblox <span aria-hidden="true">↗</span></a>}
      {related.length > 0 && <div class="related-section"><h2>More worlds to explore<span class="title-dot">.</span></h2><div class="related-links">{related.map((item) => <a href={'/games/' + item.slug + '/'}><span>{item.shortTitle ?? item.title}</span><span aria-hidden="true">↗</span></a>)}</div></div>}
    </div>
  </section>
</BaseLayout>
