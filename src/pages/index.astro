---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroScene from '../components/HeroScene.astro';
import GameCard from '../components/GameCard.astro';
import { featuredGames, games } from '../data/games';
import { sortGamesByCCU } from '../data/ccu-ranking';
import { studio, homepageLifetimeVisitsLabel } from '../data/studio';
const rankedFeatured = sortGamesByCCU(featuredGames);
---
<BaseLayout>
  <section class="hero">
    <div class="container hero-content">
      <div class="hero-copy">
        <p class="eyebrow hero-kicker"><span class="eyebrow-star" aria-hidden="true"></span> AN INDEPENDENT ROBLOX GAME STUDIO</p>
        <h1>We Build Worlds.<br/><em>You Write<br class="desktop-break"/> the Story.</em></h1>
        <p class="hero-description">From the everyday to the extraordinary, we craft immersive roleplay worlds and playful simulations that let you make the experience your own.</p>
        <div class="hero-actions">
          <a class="button button-dark" href="/games/">Explore our games <span class="outbound-arrow" aria-hidden="true"></span></a>
          <span class="hero-side-note">YOUR NEXT STORY<br/>IS WAITING.</span>
        </div>
      </div>
      <HeroScene/>
    </div>
    <div class="hero-ticker" aria-hidden="true"><div>ROLEPLAY <span class="ticker-star"></span> SIMULATION <span class="ticker-star"></span> STORIES <span class="ticker-star"></span> IMAGINATION <span class="ticker-star"></span> ROLEPLAY <span class="ticker-star"></span> SIMULATION <span class="ticker-star"></span> STORIES <span class="ticker-star"></span></div></div>
  </section>

  <section class="section section-dark featured-section" id="featured">
    <div class="container">
      <div class="section-intro">
        <div><p class="eyebrow red-eyebrow">01 / OUR WORLDS</p><h2>Find your next<br/><em>adventure.</em></h2></div>
        <div class="section-aside"><p>Every world is an invitation. Explore the worlds in our portfolio, built for players to make their own.</p><a class="text-link" href="/games/">See all {games.length} games <span class="outbound-arrow" aria-hidden="true"></span></a></div>
      </div>
      <div class="featured-grid">{rankedFeatured.map((game, index) => <GameCard game={game} index={index} featured/>)}</div>
      <div class="browse-all"><a class="button button-outline" href="/games/">Browse all experiences <span class="outbound-arrow" aria-hidden="true"></span></a></div>
    </div>
  </section>

  <section class="section numbers-section">
    <div class="container numbers-layout">
      <div><p class="eyebrow">02 / THE BIG PICTURE</p><h2>Built with<br/><em>possibility.</em></h2><p>Some worlds are for exploring. Others are for belonging. We believe the best experiences give players room to make something of their own.</p></div>
      <div class="numbers-grid">
        <div class="number-tile tile-red"><strong>{games.length}</strong><span>Playable experiences</span></div>
        <div class="number-tile tile-cream"><strong>{homepageLifetimeVisitsLabel}</strong><span>Lifetime visits</span></div>
      </div>
    </div>
  </section>

  <section class="section closing-section">
    <div class="container closing-inner">
      <div class="closing-decoration" aria-hidden="true"><span></span><span></span><span></span></div>
      <p class="eyebrow red-eyebrow">03 / THE STUDIO</p>
      <h2>Real worlds are big.<br/><em>Imagined ones are endless.</em></h2>
      <p>{studio.name} is an independent studio building roleplay and simulation experiences on Roblox. We make worlds for curiosity, connection, and the stories that happen between players.</p>
      <a class="button button-light" href="/about/">Meet the studio <span class="outbound-arrow" aria-hidden="true"></span></a>
    </div>
  </section>
</BaseLayout>
